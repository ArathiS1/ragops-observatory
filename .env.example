# Copy to .env and adjust. Never commit the real file.
RAGOPS_ADMIN_KEY=change-me-to-a-long-random-string
# Judge: heuristic (free, offline) | openai | ollama (any OpenAI-compatible endpoint) | ragas
RAGOPS_JUDGE=heuristic
RAGOPS_JUDGE_MODEL=gpt-4o-mini
# For ollama/vLLM: RAGOPS_JUDGE_BASE_URL=http://host.docker.internal:11434/v1
RAGOPS_JUDGE_BASE_URL=
RAGOPS_EMBEDDER=hashing
OPENAI_API_KEY=
# Optional SMTP for e-mail alerts
RAGOPS_SMTP_HOST=
RAGOPS_SMTP_PORT=587
RAGOPS_SMTP_USER=
RAGOPS_SMTP_PASSWORD=
RAGOPS_SMTP_FROM=ragops@example.com
